      >
        <h2
          class="m-0 text-[15px] font-semibold text-base-content"
          id="task-dialog-title"
        >
          New Task
        </h2>
        <button
          aria-label="Close dialog"
          class="flex h-7 w-7 items-center justify-center rounded text-base-content/50 transition-colors hover:bg-base-200 hover:text-base-content"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-x"
            fill="none"
            height="16"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="16"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M18 6 6 18"
            />
            <path
              d="m6 6 12 12"
            />
          </svg>
        </button>
      </div>
      <form
        class="flex flex-1 flex-col gap-4 overflow-y-auto px-5 py-5"
        id="task-dialog-form"
      >
        <div
          class="flex flex-col gap-1.5"
        >
          <label
            class="text-xs font-semibold uppercase tracking-wide text-base-content/50"
            for="task-title"
          >
            Title *
          </label>
          <input
            autocomplete="off"
            class="input input-bordered input-sm w-full font-mono text-xs"
            id="task-title"
            name="task-title"
            placeholder="Task title"
            type="text"
            value=""
          />
        </div>
        <div
          class="flex flex-col gap-1.5"
        >
          <label
            class="text-xs font-semibold uppercase tracking-wide text-base-content/50"
            for="task-desc"
          >
            Description
          </label>
          <textarea
            class="textarea textarea-bordered textarea-sm w-full font-mono text-xs min-h-[80px]"
            id="task-desc"
            placeholder="Describe the task..."
            rows="4"
          />
        </div>
        <div
          class="grid grid-cols-2 gap-3 max-md:grid-cols-1"
        >
          <div
            class="flex flex-col gap-1.5"
          >
            <label
              class="text-xs font-semibold uppercase tracking-wide text-base-content/50"
              for="task-status"
            >
              Status
            </label>
            <select
              class="select select-bordered select-sm w-full cursor-pointer font-mono text-xs"
              id="task-status"
            >
              <option
                value="todo"
              >
                Todo
              </option>
              <option
                value="in_progress"
              >
                In Progress
              </option>
              <option
                value="done"
              >
                Done
              </option>
              <option
                value="archived"
              >
                Archived
              </option>
            </select>
          </div>
          <div
            class="flex flex-col gap-1.5"
          >
            <label
              class="text-xs font-semibold uppercase tracking-wide text-base-content/50"
              for="task-priority"
            >
              Priority
            </label>
            <select
              class="select select-bordered select-sm w-full cursor-pointer font-mono text-xs"
              id="task-priority"
            >
              <option
                value="1"
              >
                1 - Low
              </option>
              <option
                value="2"
              >
                2 - Medium
              </option>
              <option
                value="3"
              >
                3 - High
              </option>
              <option
                value="4"
              >
                4 - Critical
              </option>
              <option
                value="5"
              >
                5 - Urgent
              </option>
            </select>
          </div>
        </div>
        <div
          class="grid grid-cols-2 gap-3 max-md:grid-cols-1"
        >
          <div
            class="flex flex-col gap-1.5"
          >
            <label
              class="text-xs font-semibold uppercase tracking-wide text-base-content/50"
              for="task-tags"
            >
              Tags
