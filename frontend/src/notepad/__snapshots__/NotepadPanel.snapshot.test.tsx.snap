// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`NotepadPanel snapshot > renders panel with notes 1`] = `
<div>
  <div
    class="notepad-panel"
  >
    <div
      class="notepad-tab-bar"
    >
      <div
