// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ConversationViewer snapshot > renders conversation with messages 1`] = `
<div>
  <div
    class="conv-viewer-container"
  >
    <div
      class="conv-viewer-header"
    >
      <button
        class="conv-viewer-header-btn"
        type="button"
      >
        ◀ Back
      </button>
      <span
        class="conv-viewer-header-title"
      >
        Test Session
      </span>
      <span
        class="conv-viewer-header-session-info"
      >
        claude-3-opus
      </span>
      <button
        class="conv-viewer-header-btn"
        title="Refresh conversation"
        type="button"
      >
        <span
          class=""
        >
          ↻
        </span>
      </button>
    </div>
    <div
      class="conv-viewer-body"
    >
      <div
        class="conv-msg max-w-[85%] rounded-md px-3.5 py-2.5 text-sm leading-relaxed font-mono break-words whitespace-pre-wrap self-end border border-edge bg-surface-2 text-on-surface rounded-br-sm"
        data-testid="conv-msg-user"
      >
        <div
          class="mb-1 text-2xs font-semibold uppercase tracking-wide text-primary"
        >
          user
        </div>
        <div
          class="whitespace-pre-wrap font-mono text-xs [&_code]:bg-surface-2 [&_code]:rounded-sm [&_code]:px-1 [&_code]:text-xs"
        >
          How do I run tests?
        </div>
        <div
          class="mt-1 text-right font-mono text-2xs text-on-surface-muted"
          data-testid="conv-msg-timestamp"
        >
          10:00 AM
        </div>
      </div>
      <div
        class="conv-msg max-w-[85%] rounded-md px-3.5 py-2.5 text-sm leading-relaxed font-mono break-words whitespace-pre-wrap self-start border border-surface-2 bg-surface-3 text-on-surface-2 rounded-bl-sm"
        data-testid="conv-msg-assistant"
      >
        <div
          class="mb-1 text-2xs font-semibold uppercase tracking-wide text-success"
        >
          assistant
        </div>
        <div
          class="whitespace-pre-wrap font-mono text-xs [&_code]:bg-surface [&_code]:rounded-sm [&_code]:px-1 [&_code]:text-xs"
        >
          Run \`just test\` from the project root.
        </div>
        <div
          class="mt-1 text-right font-mono text-2xs text-on-surface-muted"
          data-testid="conv-msg-timestamp"
        >
          10:00 AM
        </div>
      </div>
    </div>
  </div>
</div>
`;
