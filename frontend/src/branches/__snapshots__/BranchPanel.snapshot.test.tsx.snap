            title="3 ahead, 1 behind"
          >
            <span
              class="branch-status-ahead"
            >
              ↑
              3
            </span>
            <span
              class="branch-status-behind"
            >
              ↓
              1
            </span>
          </span>
          <div
            class="branch-actions"
          >
            <button
              aria-label="Delete branch"
              class="btn-icon btn-danger"
              title="Delete feature/login"
              type="button"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-trash2 lucide-trash-2"
                fill="none"
                height="12"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="12"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
