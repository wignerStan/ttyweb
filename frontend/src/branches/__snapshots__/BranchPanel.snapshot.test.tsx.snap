          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="14"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M15 6a9 9 0 0 0-9 9V3"
          />
          <circle
            cx="18"
            cy="6"
            r="3"
          />
          <circle
            cx="6"
            cy="18"
            r="3"
          />
        </svg>
        Branches
      </span>
      <div
        class="branch-header-actions"
      >
