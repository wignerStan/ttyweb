            fill="none"
            height="14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M5 12h14"
            />
            <path
              d="M12 5v14"
            />
          </svg>
        </button>
      </div>
    </div>
    <div
      class="branch-list"
    >
      <div
        class="branch-item branch-item--current"
      >
        <div
          class="branch-row"
        >
          <span
            class="branch-name branch-name--current"
            title="abc1234"
          >
            main
          </span>
          <span
