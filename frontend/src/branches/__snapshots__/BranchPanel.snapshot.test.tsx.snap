                />
                <path
                  d="M14 11v6"
                />
                <path
                  d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"
                />
                <path
                  d="M3 6h18"
                />
                <path
                  d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                />
              </svg>
            </button>
          </div>
        </div>
      </div>
      <div
        class="branch-item"
      >
        <div
          class="branch-row"
        >
          <span
            class="branch-name"
            title="ghi9012"
          >
            fix/header-bug
          </span>
          <span
            class="branch-status"
            title="0 ahead, 5 behind"
          >
            <span
