// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`BranchPanel snapshot > renders branch list with current, ahead/behind badges 1`] = `
<div>
  <div
    class="branch-panel"
  >
    <div
      class="branch-header"
    >
      <span
